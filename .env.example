# Environment variables template for development

# --- POSTGRESQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=scrum_db
POSTGRES_PORT=5432

# --- BACKEND ---
BACKEND_PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/scrum_db?schema=public

# --- JWT AUTHENTICATION ---
JWT_SECRET=super_secret_jwt_access_key_change_in_production_123!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_456!
JWT_REFRESH_EXPIRES_IN=7d

# --- CLOUDINARY CONFIGURATION ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- FRONTEND ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5000/api/v1
