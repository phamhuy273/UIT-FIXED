
Project UIT_FIXED {
  database_type: 'PostgreSQL'
  Note: 'Campus facility incident reporting and resolution system'
}

// ==========================================
// 1. ENUMS
// ==========================================

Enum Role {
  STUDENT
  ADMIN
  TECH_STAFF
}

Enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

Enum IncidentStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

Enum ReportHistoryAction {
  CREATED
  APPROVED
  REJECTED
  CANCELLED
}

Enum IncidentHistoryAction {
  CREATED
  ASSIGNED
  REASSIGNED
  REJECTED
  RESOLVED
  REOPENED
}

Enum IncidentUrgency {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// ==========================================
// 2. USERS & AUTHENTICATION
// ==========================================

Table users {
  id int [pk, increment]
  email varchar [not null, unique]
  password varchar [not null]
  full_name varchar
  role Role [not null, default: 'STUDENT']
  avatar_url varchar
  department_id int
  is_active boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    department_id
  }

  Note: 'TECH_STAFF must belong to exactly one Department. STUDENT and ADMIN must not belong to a Department. is_active represents account activation, not staff availability.'
}

Table email_activation_tokens {
  id int [pk, increment]
  user_id int [not null]
  token_hash varchar [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  invalidated_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }

  Note: 'Store only the token hash. Activation token is single-use and expires. Resending activation invalidates previous unused tokens.'
}

// ==========================================
// 3. ORGANIZATION & FACILITY
// ==========================================

Table departments {
  id int [pk, increment]
  name varchar [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: 'A Department can be assigned to multiple Buildings as their default Department. A Department can be deactivated only when it has no unfinished assigned Incidents.'
}

Table buildings {
  id int [pk, increment]
  name varchar [not null]
  address varchar
  description text
  default_department_id int
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    default_department_id
  }

  Note: 'A Building may have one default Department. Admin may assign an Incident to a different Department.'
}

Table floors {
  id int [pk, increment]
  building_id int [not null]
  name varchar [not null]
  floor_number int
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (building_id, name) [unique]
  }

  Note: 'A Floor belongs to exactly one Building.'
}

Table locations {
  id int [pk, increment]
  building_id int [not null]
  floor_id int
  name varchar [not null]
  location_type varchar
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    building_id
    floor_id
  }

  Note: 'A Location belongs to one Building and optionally one Floor. If floor_id is not null, its Floor must belong to the same Building. Location names are not globally unique.'
}

Table categories {
  id int [pk, increment]
  name varchar [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: 'Inactive Categories cannot be selected for new Reports. Used Categories should not be hard-deleted.'
}

// ==========================================
// 4. MEDIA
// ==========================================

Table media {
  id int [pk, increment]
  public_id varchar [not null, unique]
  url varchar [not null]
  format varchar
  bytes int
  user_id int
  report_id int
  resolution_id int
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    report_id
    resolution_id
  }

  Note: 'Media can be temporarily unattached. A Media record can belong to a User, an IncidentReport, or an IncidentResolution, but must not be attached to multiple parent types simultaneously. Report photos and Resolution photos remain separate.'
}

// ==========================================
// 5. INCIDENT REPORTS
// ==========================================

Table incident_reports {
  id int [pk, increment]
  student_id int [not null]
  category_id int [not null]
  building_id int [not null]
  location_id int [not null]
  title varchar [not null]
  description text [not null]
  urgency IncidentUrgency
  status ReportStatus [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    student_id
    category_id
    building_id
    location_id
    status
    created_at
  }

  Note: 'Student creates and owns the Report. Student-proposed urgency is optional. Student can cancel only a PENDING Report. Location must belong to the selected Building.'
}

Table incident_report_histories {
  id int [pk, increment]
  report_id int [not null]
  actor_id int [not null]
  action ReportHistoryAction [not null]
  from_status ReportStatus
  to_status ReportStatus [not null]
  reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    report_id
    actor_id
    created_at
  }

  Note: 'Append-only history for Report creation, approval, rejection, and cancellation. Rejection and cancellation require a reason.'
}

// ==========================================
// 6. INCIDENTS
// ==========================================

Table incidents {
  id int [pk, increment]
  report_id int [not null, unique]
  status IncidentStatus [not null, default: 'PENDING_ASSIGNMENT']
  urgency IncidentUrgency [not null]
  deadline timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    status
    urgency
    deadline
  }

  Note: 'In MVP, one approved Report creates exactly one Incident. Incident urgency is confirmed or adjusted by Admin before creation. Incident cannot be cancelled.'
}

// ==========================================
// 7. INCIDENT ASSIGNMENTS
// ==========================================

Table incident_assignments {
  id int [pk, increment]
  incident_id int [not null]
  department_id int [not null]
  assigned_by_id int [not null]
  assignee_id int [not null]
  is_current boolean [not null, default: true]
  is_active boolean [not null, default: true]
  ended_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    incident_id
    department_id
    assigned_by_id
    assignee_id
  }

  Note: 'Admin directly assigns an Incident to one Tech Staff in the selected Department. Assignment takes effect immediately. Tech Staff may reject it with a required reason recorded in IncidentHistory. is_current identifies the current allocation of an Incident. is_active identifies an Assignment currently occupying the Tech Staff workload.'
}

// ==========================================
// 8. INCIDENT PROGRESS NOTES
// ==========================================

Table incident_progress_notes {
  id int [pk, increment]
  incident_id int [not null]
  author_id int [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    incident_id
    author_id
    created_at
  }

  Note: 'Tech Staff adds progress updates while handling an assigned Incident. Progress notes are not a replacement for IncidentHistory or IncidentResolution.'
}

// ==========================================
// 9. INCIDENT RESOLUTIONS
// ==========================================

Table incident_resolutions {
  id int [pk, increment]
  incident_id int [not null]
  resolved_by_id int [not null]
  resolution_note text [not null]
  resolved_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    incident_id
    resolved_by_id
    resolved_at
  }

  Note: 'An Incident may have multiple Resolution records because Admin can reopen a resolved Incident. Each Resolution is preserved as history.'
}

// ==========================================
// 10. INCIDENT HISTORY
// ==========================================

Table incident_histories {
  id int [pk, increment]
  incident_id int [not null]
  actor_id int [not null]
  assignment_id int
  resolution_id int
  action IncidentHistoryAction [not null]
  from_status IncidentStatus
  to_status IncidentStatus
  reason text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    incident_id
    actor_id
    assignment_id
    resolution_id
    created_at
  }

  Note: 'Append-only Incident lifecycle history. REJECTED requires a reason and references the rejected Assignment. REOPENED references both the newly created Assignment and the previous Resolution.'
}

// ==========================================
// 11. RELATIONSHIPS
// ==========================================

// Users
Ref: users.department_id > departments.id
Ref: email_activation_tokens.user_id > users.id

// Buildings and Departments
Ref: buildings.default_department_id > departments.id
Ref: floors.building_id > buildings.id
Ref: locations.building_id > buildings.id
Ref: locations.floor_id > floors.id

// Media
Ref: media.user_id > users.id
Ref: media.report_id > incident_reports.id
Ref: media.resolution_id > incident_resolutions.id

// Incident Reports
Ref: incident_reports.student_id > users.id
Ref: incident_reports.category_id > categories.id
Ref: incident_reports.building_id > buildings.id
Ref: incident_reports.location_id > locations.id

Ref: incident_report_histories.report_id > incident_reports.id
Ref: incident_report_histories.actor_id > users.id

// Incidents
Ref: incidents.report_id - incident_reports.id

// Assignments
Ref: incident_assignments.incident_id > incidents.id
Ref: incident_assignments.department_id > departments.id
Ref: incident_assignments.assigned_by_id > users.id
Ref: incident_assignments.assignee_id > users.id

// Progress Notes
Ref: incident_progress_notes.incident_id > incidents.id
Ref: incident_progress_notes.author_id > users.id

// Resolutions
Ref: incident_resolutions.incident_id > incidents.id
Ref: incident_resolutions.resolved_by_id > users.id

// Incident Histories
Ref: incident_histories.incident_id > incidents.id
Ref: incident_histories.actor_id > users.id
Ref: incident_histories.assignment_id > incident_assignments.id
Ref: incident_histories.resolution_id > incident_resolutions.id
